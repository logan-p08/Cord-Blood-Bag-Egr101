{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.associations": {
      "*.ino": "cpp"
    }
  },
  "extensions": {
    "recommendations": [
      "platformio.platformio-ide"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "PlatformIO: Build",
        "type": "shell",
        "command": "pio",
        "args": [
          "run"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "PlatformIO: Upload",
        "type": "shell",
        "command": "pio",
        "args": [
          "run",
          "--target",
          "upload"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "PlatformIO: Serial Monitor (9600)",
        "type": "shell",
        "command": "pio",
        "args": [
          "device",
          "monitor",
          "--baud",
          "9600"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      }
    ]
  }
}
